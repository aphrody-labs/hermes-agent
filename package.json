{
  "name": "hermes-agent",
  "version": "1.0.0",
  "description": "An AI agent with advanced tool-calling capabilities, featuring a flexible toolsets system for organizing and managing tools.",
  "private": true,
  "workspaces": [
    "apps/*",
    "ui-tui",
    "ui-tui/packages/*",
    "web",
    "tests-js"
  ],
  "scripts": {
    "postinstall": "echo \"Workspace dependencies installed. Run: hermes --help\"",
    "install:root": "bun install",
    "install:web": "bun install --filter ./web",
    "install:tui": "bun install --filter ./ui-tui",
    "install:desktop": "bun install --filter ./apps/desktop",
    "audit:root": "bun audit",
    "audit:web": "bun audit --filter ./web",
    "audit:tui": "bun audit --filter ./ui-tui",
    "audit:fix:root": "bun audit --fix",
    "audit:fix:web": "bun audit --fix --filter ./web",
    "audit:fix:tui": "bun audit --fix --filter ./ui-tui",
    "check": "bun run --filter '*' check",
    "fix": "bun run --filter '*' fix",
    "prepare": "bun -e \"const {existsSync}=require('fs');const {spawnSync}=require('child_process');if(existsSync('.git'))spawnSync('lefthook',['install'],{stdio:'inherit',shell:true})\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NousResearch/Hermes-Agent.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NousResearch/Hermes-Agent/issues"
  },
  "homepage": "https://github.com/NousResearch/Hermes-Agent#readme",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "10.12.0",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0",
    "lefthook": "2.1.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0"
  },
  "overrides": {
    "@electron/osx-sign": {
      "isbinaryfile": "5.0.7"
    },
    "lodash": "4.18.1",
    "protobufjs": "^8.7.1",
    "brace-expansion": "5.0.12",
    "mermaid": "11.16.1",
    "dompurify": "3.4.17",
    "katex": "0.18.4",
    "ip-address": "10.7.4",
    "nanoid@^3": "3.3.20",
    "nanoid@^6": "6.0.0",
    "js-yaml@^4": "4.3.2",
    "undici@^6": "6.29.0",
    "undici@^7": "7.30.0",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6",
    "tar": "7.5.22",
    "source-map-js": "1.2.2",
    "yaml": "2.9.1",
    "vitest": "4.1.12",
    "@vitest/mocker": "4.1.12"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "trustedDependencies": [
    "electron-winstaller",
    "esbuild",
    "fsevents",
    "get-windows",
    "lefthook",
    "node-pty"
  ],
  "dependencies": {
    "js-yaml": "4.3.2",
    "semver": "7.7.4"
  }
}
